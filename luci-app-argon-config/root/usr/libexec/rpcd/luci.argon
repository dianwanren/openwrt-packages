#!/bin/sh

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

readonly bg_path="/www/luci-static/argon/background"
readonly tmp_path="/tmp/argon_background.tmp"

case "$1" in
"list")
	json_init
	json_add_object "avail"
	json_close_object
	json_add_object "remove"
		json_add_string "filename" "filename"
	json_close_object
	json_add_object "rename"
		json_add_string "newname" "filename"
	json_close_object
	json_dump
	json_cleanup
	;;
"call")
	case "$2" in
	"avail")
		json_init

		# 直接询问背景目录所在的文件系统。
		# 不要再去解析 `df` 全量输出的 "/" 行：在 overlayfs / 新版
		# OpenWrt 上那一行的字段并不稳定，取不到值时会变成 0。
		avail=
		for dir in "$bg_path" "/www/luci-static/argon" "/www" "/"; do
			[ -d "$dir" ] || continue
			avail="$(df -k "$dir" 2>/dev/null | awk 'NR > 1 && $4 ~ /^[0-9]+$/ && $4 + 0 > 0 { print $4; exit }')"
			[ -n "$avail" ] && break
		done

		# df 拿不到时退回 statvfs，单位统一换算成 KB（前端会再乘 1024）
		if [ -z "$avail" ]; then
			avail="$(stat -f -c '%a %S' "$bg_path" 2>/dev/null | awk '{ v = ($1 * $2) / 1024; if (v > 0) printf "%.0f", v }')"
		fi

		case "$avail" in
			''|*[!0-9]*) avail=0 ;;
		esac

		json_add_int "avail" "$avail"
		json_dump
		json_cleanup
		;;
	"remove")
		read -r input
		json_load "$input"
		json_get_var filename "filename"
		json_cleanup

		if dirname "$filename" | grep -q ".."; then
			echo '{ "result": 255 }'
			exit 255
		fi

		rm -f "$bg_path/$filename"
		echo '{ "result": 0 }'
		;;
	"rename")
		read -r input
		json_load "$input"
		json_get_var newname "newname"
		json_cleanup

		if dirname "$newname" | grep -q ".."; then
			echo '{ "result": 255 }'
			exit 255
		fi

		if mv "$tmp_path" "$bg_path/$newname" 2>"/dev/null"; then
			chmod 0644 "$bg_path/$newname"
			echo '{ "result": 0 }'
		else
			echo '{ "result": 1 }'
		fi
		;;
	esac
	;;
esac
